#!/usr/bin/env bash
# obsidian-vault — open a folder as an Obsidian vault.
#
# obsidian:// URIs only reach folders Obsidian already knows, and no flag
# adds a new one. So this goes through Obsidian's CLI instead: `eval` runs
# JS inside the app, which sends the same `vault-open` message the "Open
# folder as vault" button does. Obsidian then registers the folder (or
# finds it, when known) and opens its window itself — we never touch its
# config files. Needs the CLI on (Settings > General > Advanced).
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: obsidian-vault [dir]

Open dir (default: the current directory) as an Obsidian vault, creating
the folder when missing. Launches Obsidian first when it is not running.

Environment:
  OBSIDIAN_VAULT_WAIT  seconds to wait for Obsidian's CLI (default: 30)
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac
if [ $# -gt 1 ]; then
  usage >&2
  exit 2
fi

wait_secs=${OBSIDIAN_VAULT_WAIT:-30}
target=${1:-.}
mkdir -p -- "$target"
dir=$(cd -- "$target" && pwd)

# The CLI reads stdin when it has one and then never exits, so detach it;
# the alarm caps a call that hangs anyway.
cli() {
  perl -e 'alarm shift; exec @ARGV' 10 obsidian "$@" </dev/null 2>&1
}

if ! pgrep -xq Obsidian; then
  open -a Obsidian
fi

ready=false
for _ in $(seq $((wait_secs * 2))); do
  if [ "$(cli eval code=1 || true)" = "=> 1" ]; then
    ready=true
    break
  fi
  sleep 0.5
done
if ! $ready; then
  echo "obsidian-vault: Obsidian's CLI did not answer; is it enabled in" \
    "Settings > General > Advanced?" >&2
  exit 1
fi

path_json=$(jq -Rn --arg p "$dir" '$p')
result=$(cli eval \
  code="window.electron.ipcRenderer.sendSync('vault-open', $path_json, false)" ||
  true)
case "$result" in
"=> true") exit 0 ;;
# When the call opens a new window the CLI often loses the reply, even
# though the vault opened — check Obsidian's vault list instead, giving
# the new window a moment to land in it.
"")
  for _ in $(seq 10); do
    cli vaults verbose | cut -f 2- | grep -qxF -- "$dir" && exit 0
    sleep 0.5
  done
  ;;
esac
result=${result#=> }
echo "obsidian-vault: could not open $dir: ${result:-no reply}" >&2
exit 1
