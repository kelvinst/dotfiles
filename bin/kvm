#!/usr/bin/env bash
# Hands a KVM monitor between two Macs without breaking Universal Control.
#
# A Mac the monitor isn't showing still keeps it attached, so Universal
# Control lays that Mac out as "monitor + built-in" and the cursor has to
# cross a monitor nobody can see to reach the built-in. Mirroring the
# built-in onto the monitor makes it one screen again. Each Mac runs
# `kvm watch`, which mirrors while the monitor shows the other Mac and
# extends again when it comes back; `kvm toggle` only switches the input.
set -uo pipefail

CONFIG=${KVM_CONFIG:-"$HOME/.config/kvm/config"}
STATE_DIR=${KVM_STATE_DIR:-"${XDG_STATE_HOME:-$HOME/.local/state}/kvm"}
EXTENDED="$STATE_DIR/extended"
AGENT_LABEL=com.kelvinst.kvm
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

usage() {
  cat <<'EOF'
Usage: kvm <command>

  toggle   Switch the monitor's input to the other Mac, or back to this one.
  arrange  Open the Arrange Displays sheet to place the other Mac.
  relink   Link keyboard and mouse to the other Mac again, through the
           Displays pane's + menu.
  sync     Mirror or extend this Mac's displays to match the current input.
  watch    Run sync whenever the input changes (what the agent runs).
  agent install <this-input> <other-input> [<monitor-name>]
           Save the config and start `kvm watch` as a LaunchAgent.
           Inputs are VCP 0x60 codes (USB-C 27, HDMI 1 17, DP 15);
           the monitor name defaults to U3223QE.
  agent uninstall
           Stop and remove the LaunchAgent.

Needs m1ddc and displayplacer (brew install m1ddc displayplacer).
EOF
}

warn() {
  echo "kvm: $*" >&2
}

die() {
  warn "$@"
  exit 1
}

load_config() {
  [ -f "$CONFIG" ] || die "no $CONFIG; run kvm agent install first"
  INPUT='' OTHER_INPUT='' MONITOR=U3223QE
  # shellcheck source=/dev/null
  . "$CONFIG"
  [ -n "$INPUT" ] && [ -n "$OTHER_INPUT" ] || die "$CONFIG needs INPUT and OTHER_INPUT"
}

monitor_uuid() {
  m1ddc display list 2>/dev/null |
    sed -n "s/.*$MONITOR.*(\([0-9A-F-]*\)).*/\1/p" | head -1
}

# The input the monitor shows, as INPUT or OTHER_INPUT. The Dell answers
# in the low byte (0x1B1B for USB-C) and about half the reads come back as
# garbage (48750), so anything else is retried, then given up on.
current_input() {
  local uuid=$1 value low
  for _ in 1 2 3 4 5; do
    value=$(m1ddc display "$uuid" get input 2>/dev/null)
    if [[ $value =~ ^[0-9]+$ ]]; then
      low=$((value & 255))
      if [ "$low" = "$INPUT" ] || [ "$low" = "$OTHER_INPUT" ]; then
        echo "$low"
        return 0
      fi
    fi
    sleep 0.1
  done
  return 1
}

# The command `displayplacer list` ends with: the one that recreates the
# current arrangement, one quoted screen per argument.
arrangement() {
  displayplacer list | tail -1
}

builtin_uuid() {
  displayplacer list | awk '
    /^Persistent screen id:/ { id = $4 }
    /^Type: MacBook built in screen/ { print id; exit }'
}

mirror() {
  local monitor=$1 current builtin screen
  current=$(arrangement)
  # Already mirrored: `kvm toggle` and the watcher both sync the same
  # switch, and saving the second one's view would lose the extended layout.
  [[ $current == *"+"* ]] && return 0
  builtin=$(builtin_uuid)
  [ -n "$builtin" ] || { warn "no built-in screen in displayplacer list"; return 1; }
  # Kept to put back when the monitor returns.
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$current" >"$EXTENDED"
  screen=$(grep -o "\"id:$builtin [^\"]*\"" <<<"$current" | tr -d '"')
  [ -n "$screen" ] || { warn "built-in not in: $current"; return 1; }
  screen=${screen/id:$builtin/id:$builtin+$monitor}
  screen=$(sed 's/origin:([^)]*)/origin:(0,0)/' <<<"$screen")
  displayplacer "$screen"
}

extend() {
  [ -s "$EXTENDED" ] || { warn "mirrored, but no saved arrangement in $EXTENDED"; return 1; }
  local saved
  saved=$(cat "$EXTENDED")
  # The saved line is displayplacer's own output: a command whose screens
  # are double-quoted arguments.
  eval "set -- ${saved#displayplacer }"
  displayplacer "$@"
}

sync_to() {
  local monitor=$1 input=$2 mirrored=false
  [[ $(arrangement) == *"+$monitor"* || $(arrangement) == *"$monitor+"* ]] &&
    mirrored=true
  if [ "$input" = "$INPUT" ] && $mirrored; then
    extend
  elif [ "$input" = "$OTHER_INPUT" ] && ! $mirrored; then
    mirror "$monitor"
  fi
}

cmd_sync() {
  load_config
  local monitor input
  monitor=$(monitor_uuid)
  [ -n "$monitor" ] || return 0
  input=$(current_input "$monitor") || return 0
  sync_to "$monitor" "$input"
}

cmd_toggle() {
  load_config
  local monitor input
  monitor=$(monitor_uuid)
  [ -n "$monitor" ] || die "no $MONITOR on m1ddc display list"
  input=$(current_input "$monitor") || die "can't read the input from $MONITOR"
  if [ "$input" = "$INPUT" ]; then
    m1ddc display "$monitor" set input "$OTHER_INPUT" >/dev/null
    sync_to "$monitor" "$OTHER_INPUT"
  else
    m1ddc display "$monitor" set input "$INPUT" >/dev/null
    sync_to "$monitor" "$INPUT"
  fi
}

# Clicks Arrange… on the Displays pane, through Hammerspoon: System Events
# takes about ten seconds to walk the pane, Hammerspoon half a second. The
# button's accessibility label doesn't say Arrange, so press the 24pt-tall
# buttons top to bottom until one opens the sheet, closing any other sheet
# on the way. Prints "ok" once the sheet is up, "wait" while the pane isn't
# ready yet.
ARRANGE_LUA='
local app = hs.application.get("com.apple.systempreferences")
if not app then return "wait" end
local win
for _, w in ipairs(hs.axuielement.applicationElement(app):attributeValue("AXWindows") or {}) do
  if w:attributeValue("AXTitle") == "Displays" then win = w end
end
if not win then return "wait" end
local function find(e, test, out)
  if test(e) then table.insert(out, e) end
  for _, k in ipairs(e:attributeValue("AXChildren") or {}) do find(k, test, out) end
  return out
end
local function sheet()
  for _, k in ipairs(win:attributeValue("AXChildren") or {}) do
    if k:attributeValue("AXRole") == "AXSheet" then return k end
  end
end
local function isArrange(s)
  return #find(s, function(e)
    return tostring(e:attributeValue("AXValue")):find("Arrange") ~= nil
  end, {}) > 0
end
local s = sheet()
if s and isArrange(s) then return "ok" end
local buttons = find(win, function(e)
  local size = e:attributeValue("AXSize")
  return e:attributeValue("AXRole") == "AXButton" and size and size.h == 24
end, {})
table.sort(buttons, function(a, b)
  return a:attributeValue("AXPosition").y < b:attributeValue("AXPosition").y
end)
for _, b in ipairs(buttons) do
  b:performAction("AXPress")
  hs.timer.usleep(300000)
  s = sheet()
  if s then
    if isArrange(s) then return "ok" end
    local close = find(s, function(e) return e:attributeValue("AXRole") == "AXButton" end, {})
    if close[1] then close[1]:performAction("AXPress") end
    hs.timer.usleep(300000)
  end
end
return "wait"
'

# Picks the other Mac under "Link keyboard and mouse to" in the Displays
# pane's + menu, the way you'd link it by hand. Prints "ok" once pressed,
# "none" when the menu lists no Mac to link, "wait" while the pane loads or
# after closing a sheet.
LINK_LUA='
local app = hs.application.get("com.apple.systempreferences")
if not app then return "wait" end
-- Pressing + can block until its menu closes; a short timeout lets this
-- pass give up and the next one use the open menu.
local ax = hs.axuielement.applicationElement(app)
ax:setTimeout(2)
local win
for _, w in ipairs(ax:attributeValue("AXWindows") or {}) do
  if w:attributeValue("AXTitle") == "Displays" then win = w end
end
if not win then return "wait" end
-- An open sheet (Arrange, say) sits over the + button: close it first,
-- through its first button (Done), which sits a few groups down.
local function firstButton(e)
  if e:attributeValue("AXRole") == "AXButton" then return e end
  for _, k in ipairs(e:attributeValue("AXChildren") or {}) do
    local b = firstButton(k)
    if b then return b end
  end
end
for _, k in ipairs(win:attributeValue("AXChildren") or {}) do
  if k:attributeValue("AXRole") == "AXSheet" then
    local b = firstButton(k)
    if b then b:performAction("AXPress") end
    -- + hangs while the sheet animates away; the next pass presses it.
    return "wait"
  end
end
local add
local function walk(e)
  if e:attributeValue("AXRole") == "AXMenuButton" and e:attributeValue("AXTitle") == "Add" then add = e end
  for _, k in ipairs(e:attributeValue("AXChildren") or {}) do walk(k) end
end
walk(win)
if not add then return "wait" end
-- The menu only shows as a child of + while it is open. An earlier pass
-- that timed out may have left it open; pressing + again would close it.
local menu = (add:attributeValue("AXChildren") or {})[1]
if not menu then
  add:performAction("AXPress")
  hs.timer.usleep(500000)
  menu = (add:attributeValue("AXChildren") or {})[1]
end
local items = menu and menu:attributeValue("AXChildren") or {}
for i, it in ipairs(items) do
  if it:attributeValue("AXTitle") == "Link keyboard and mouse to" then
    local mac = items[i + 1]
    if mac and mac:attributeValue("AXEnabled") and (mac:attributeValue("AXTitle") or "") ~= "" then
      -- A checkmark means it is linked already; a press could unlink it.
      if (mac:attributeValue("AXMenuItemMarkChar") or "") == "" then
        mac:performAction("AXPress")
      else
        menu:performAction("AXCancel")
      end
      return "ok"
    end
  end
end
if not menu then return "wait" end
menu:performAction("AXCancel")
return "none"
'

cmd_relink() {
  open "x-apple.systempreferences:com.apple.Displays-Settings.extension"
  command -v hs >/dev/null || die "no hs (Hammerspoon's CLI) to press the link item"
  local deadline=$((SECONDS + 15)) out
  while [ "$SECONDS" -lt "$deadline" ]; do
    out=$(hs -t 5 -c "$LINK_LUA" 2>/dev/null)
    case $out in
    ok) return 0 ;;
    none) die "the Displays + menu lists no Mac to link; is it awake and nearby?" ;;
    esac
    sleep 0.5
  done
  die "couldn't reach the Displays + menu"
}

cmd_arrange() {
  open "x-apple.systempreferences:com.apple.Displays-Settings.extension"
  command -v hs >/dev/null || die "no hs (Hammerspoon's CLI) to press Arrange…"
  # The pane takes a moment to load, and Arrange only shows while another
  # display or Mac is linked. Each call gets a few seconds, so one stuck in
  # Hammerspoon can't stall the loop.
  local deadline=$((SECONDS + 10))
  while [ "$SECONDS" -lt "$deadline" ]; do
    [ "$(hs -t 5 -c "$ARRANGE_LUA" 2>/dev/null)" = ok ] && return 0
    sleep 0.25
  done
  die "no Arrange… on the Displays pane; is the other Mac linked? (kvm relink)"
}

cmd_watch() {
  load_config
  local monitor input last='' failed=''
  while :; do
    monitor=$(monitor_uuid)
    if [ -n "$monitor" ] && input=$(current_input "$monitor"); then
      # Only on a change: displayplacer list is the slow part, and a toggle
      # on this Mac has already synced. A failed sync stays unrecorded, so
      # the next poll retries it — quietly, or a failure that never clears
      # would log twice a second.
      if [ "$input" != "$last" ]; then
        if [ "$input" = "$failed" ]; then
          sync_to "$monitor" "$input" 2>/dev/null
        else
          sync_to "$monitor" "$input"
        fi && last=$input failed='' || failed=$input
      fi
    fi
    sleep "${KVM_INTERVAL:-0.5}"
  done
}

cmd_agent() {
  case ${1:-} in
  install)
    [ $# -ge 3 ] || die "usage: kvm agent install <this-input> <other-input> [<monitor-name>]"
    mkdir -p "$(dirname "$CONFIG")" "$(dirname "$AGENT_PLIST")" "$HOME/Library/Logs"
    printf 'INPUT=%s\nOTHER_INPUT=%s\nMONITOR=%s\n' "$2" "$3" "${4:-U3223QE}" >"$CONFIG"
    cat >"$AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$(cd "$(dirname "$0")" && pwd)/$(basename "$0")</string><string>watch</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/kvm.log</string>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" || die "launchctl bootstrap failed"
    echo "kvm watch running as $AGENT_LABEL; config in $CONFIG"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null
    rm -f "$AGENT_PLIST"
    ;;
  *) usage >&2 && exit 1 ;;
  esac
}

case ${1:-} in
toggle) cmd_toggle ;;
arrange) cmd_arrange ;;
relink) cmd_relink ;;
sync) cmd_sync ;;
watch) cmd_watch ;;
agent) shift && cmd_agent "$@" ;;
-h | --help | help) usage ;;
*) usage >&2 && exit 1 ;;
esac
