#!/usr/bin/env bash
# Git status segment for the starship prompt.
#
# Renders the flags itself rather than using starship's git_status module,
# which cannot hide the in-sync marker when other flags are present.
#
# Prints nothing outside a work tree. Colours are emitted raw; starship
# wraps custom output in %{ %} so zsh still counts the prompt width right.
set -uo pipefail

status=$(git status --porcelain=v2 --branch --show-stash --ignore-submodules 2>/dev/null) || exit 0

printf '%s\n' "$status" | awk '
function paint(colour, text) { return "\033[1;38;" colour "m" text }

/^# branch\.ab / { ahead = $3 + 0; behind = -($4 + 0) }
/^# stash /      { stashed = $3 + 0 }
/^u /            { conflicted++ }
/^\? /           { untracked++ }
/^[12] / {
  index_state = substr($2, 1, 1)
  work_state  = substr($2, 2, 1)

  if (index_state == "R")      renamed++
  else if (index_state != ".") staged++

  if (work_state == "M")      modified++
  else if (work_state == "D") deleted++
  else if (work_state == "T") typechanged++
}

END {
  PINK = "2;255;175;243"   # fg-pink from the starship palette
  # Three separate things, joined the way the rest of the prompt joins
  # parts that stand on their own: what the files are doing, what is
  # stashed, and how far the branch has drifted from its upstream.
  if (conflicted)  files = files paint("5;196", "!" conflicted)
  if (deleted)     files = files paint("5;3",   "x" deleted)
  if (renamed)     files = files paint("5;3",   "r" renamed)
  if (modified)    files = files paint("5;3",   "m" modified)
  if (typechanged) files = files paint("5;3",   "t" typechanged)
  if (staged)      files = files paint("5;3",   "+" staged)
  if (untracked)   files = files paint("5;3",   "?" untracked)

  if (stashed)     stash = paint("5;4", "$" stashed)

  if (ahead)       upstream = upstream paint(PINK, ">" ahead)
  if (behind)      upstream = upstream paint(PINK, "<" behind)

  out = files
  if (stash != "")    out = (out == "") ? stash    : out "\033[0m:" stash
  if (upstream != "") out = (out == "") ? upstream : out "\033[0m:" upstream

  # Nothing to report is worth no characters at all.
  if (out == "") exit
  printf "%s\033[0m", out
}
'
