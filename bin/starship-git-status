#!/usr/bin/env bash
# Git status segment for the starship prompt.
#
# Renders the flags itself rather than using starship's git_status module,
# which cannot hide the in-sync marker when other flags are present.
#
# Prints nothing outside a work tree. Colours are emitted raw; starship
# wraps custom output in %{ %} so zsh still counts the prompt width right.
set -uo pipefail

status=$(git status --porcelain=v2 --branch --show-stash --ignore-submodules 2>/dev/null) || exit 0

printf '%s\n' "$status" | awk '
function paint(colour, text) { return "\033[1;38;" colour "m" text }

/^# branch\.ab / { ahead = $3 + 0; behind = -($4 + 0) }
/^# stash /      { stashed = $3 + 0 }
/^u /            { conflicted++ }
/^\? /           { untracked++ }
/^[12] / {
  index_state = substr($2, 1, 1)
  work_state  = substr($2, 2, 1)

  if (index_state == "R")      renamed++
  else if (index_state != ".") staged++

  if (work_state == "M")      modified++
  else if (work_state == "D") deleted++
  else if (work_state == "T") typechanged++
}

END {
  PINK = "2;255;175;243"   # fg-pink from the starship palette
  # Order follows the git_status module this replaces. Every kind of
  # uncommitted work shares yellow; only what needs a decision stands out.
  if (conflicted)  flags = flags paint("5;196", "!=" conflicted)
  if (stashed)     flags = flags paint("5;4",   "$" stashed)
  if (deleted)     flags = flags paint("5;3",   "x" deleted)
  if (renamed)     flags = flags paint("5;3",   "r" renamed)
  if (modified)    flags = flags paint("5;3",   "!" modified)
  if (typechanged) flags = flags paint("5;3",   "t" typechanged)
  if (staged)      flags = flags paint("5;3",   "+" staged)
  if (untracked)   flags = flags paint("5;3",   "?" untracked)

  if (ahead)       flags = flags paint(PINK, ">" ahead)
  if (behind)      flags = flags paint(PINK, "<" behind)
  # Only worth saying nothing is going on when nothing else is.
  if (flags == "") flags = paint("5;2", "=")

  printf "%s\033[0m", flags
}
'
