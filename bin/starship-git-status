#!/usr/bin/env bash
# Git status segment for the starship prompt.
#
# Renders the flags itself rather than using starship's git_status module,
# which cannot hide the in-sync marker when other flags are present.
#
# Prints nothing outside a work tree. Colours are emitted raw; starship
# wraps custom output in %{ %} so zsh still counts the prompt width right.
set -uo pipefail

status=$(git status --porcelain=v2 --branch --show-stash --ignore-submodules 2>/dev/null) || exit 0
gitdir=$(git rev-parse --git-dir 2>/dev/null)

# Git records a half-finished operation as files in the git dir, not in the
# status output. Tokens match the ones [git_state] uses in the full prompt.
state=''
if [[ -d $gitdir/rebase-merge ]]; then
  state="rb$(cat "$gitdir/rebase-merge/msgnum" 2>/dev/null)/$(cat "$gitdir/rebase-merge/end" 2>/dev/null)"
elif [[ -d $gitdir/rebase-apply ]]; then
  state="rb$(cat "$gitdir/rebase-apply/next" 2>/dev/null)/$(cat "$gitdir/rebase-apply/last" 2>/dev/null)"
elif [[ -f $gitdir/MERGE_HEAD ]]; then       state=mg
elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then state=cp
elif [[ -f $gitdir/REVERT_HEAD ]]; then      state=rv
elif [[ -f $gitdir/BISECT_LOG ]]; then       state=bs
fi

printf '%s\n' "$status" | awk -v state="$state" '
function paint(colour, text) { return "\033[1;38;" colour "m" text }

/^# branch\.oid /  { if ($3 != "(initial)") oid = substr($3, 1, 7) }
/^# branch\.head / { detached = ($3 == "(detached)") }
/^# branch\.ab / { ahead = $3 + 0; behind = -($4 + 0) }
/^# stash /      { stashed = $3 + 0 }
/^u /            { conflicted++ }
/^\? /           { untracked++ }
/^[12] / {
  index_state = substr($2, 1, 1)
  work_state  = substr($2, 2, 1)

  if (index_state == "R")      renamed++
  else if (index_state != ".") staged++

  if (work_state == "M")      modified++
  else if (work_state == "D") deleted++
  else if (work_state == "T") typechanged++
}

END {
  PINK = "2;255;175;243"   # fg-pink from the starship palette
  # Two things, joined the way the rest of the prompt joins parts that
  # stand on their own: what is committed or parked somewhere you cannot
  # see, then what the files in front of you are doing.
  if (conflicted)  files = files paint("5;196", "!" conflicted)
  if (deleted)     files = files paint("5;1", "x" deleted)
  if (renamed)     files = files paint("5;6", "r" renamed)
  if (modified)    files = files paint("5;3", "m" modified)
  if (typechanged) files = files paint("5;5", "t" typechanged)
  if (staged)      files = files paint("5;46", "+" staged)
  if (untracked)   files = files paint("5;240", "?" untracked)

  if (stashed)     elsewhere = paint("5;4", "$" stashed)
  if (ahead)       elsewhere = elsewhere paint(PINK, ">" ahead)
  if (behind)      elsewhere = elsewhere paint(PINK, "<" behind)

  # Where you are, but only when it is not the ordinary case: on a branch
  # with nothing half-finished there is nothing here worth the width.
  if (state != "")                where = paint("5;3", state)
  else if (detached && oid != "") where = paint("5;5", oid)

  out = where
  if (elsewhere != "") out = (out == "") ? elsewhere : out "\033[0m:" elsewhere
  if (files != "")     out = (out == "") ? files     : out "\033[0m:" files

  # Nothing to report is worth no characters at all.
  if (out == "") exit
  printf "%s\033[0m", out
}
'
