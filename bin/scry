#!/usr/bin/env bash
# scry — our Obsidian CLI wrapper with more commands
#
# Obsidian's own CLI (`obsidian-cli`) works on the files of a vault but cannot
# add, close or forget vaults, and obsidian:// URIs only reach vaults it
# already knows. Its `eval` runs JS inside the app, though, so the commands
# here send the same IPC messages Obsidian's own vault picker does
# (`vault-open`, `vault-remove`, `vault-list`) and Obsidian does the work
# itself — nothing here edits its config files.
#
# Always `obsidian-cli`, never `obsidian`: on a case-insensitive disk that
# name is the app binary itself, which relays to a running app but, while
# the app is down or still starting, launches another Obsidian inside the
# terminal and leaves the CLI socket dead until Obsidian restarts.
set -euo pipefail

cmd_help() {
  cat <<'EOF'
scry — Obsidian helper.

Usage: scry <command> [args...]

Commands:
  open     Open a folder as a vault, registering it when new.

  close    Close a vault's window, keeping it in the vault list.

  remove   Close a vault's window and forget the vault.

  prune    Forget every vault whose folder no longer exists.

  list     List known vaults: id, open/closed, path.

  which    Print the vault a path belongs to.

  restart  Quit Obsidian and launch it again.

  help     Show this help.

Run `scry <command> help` for details on a command.

Any other command, or none, is forwarded to `obsidian-cli` verbatim, so
`scry search query=foo` runs `obsidian-cli search query=foo` and a bare `scry`
opens Obsidian's interactive CLI.

Needs Obsidian's CLI on (Settings > General > Advanced). Obsidian is
launched when it is not running.

Environment:
  SCRY_WAIT       seconds to wait for Obsidian's CLI to answer (default: 30)
  SCRY_QUIT_WAIT  seconds `restart` waits for Obsidian to quit before
                  killing it (default: 10)
EOF
}

cmd_open_help() {
  cat <<'EOF'
Usage: scry open [dir]

Open dir (default: the current directory) as an Obsidian vault, creating
the folder when missing. A folder Obsidian already knows just opens; a new
one is added to its vault list first, as "Open folder as vault" does.
EOF
}

cmd_close_help() {
  cat <<'EOF'
Usage: scry close <dir>...

Close each vault's window, as closing it by hand does. The vault stays in
Obsidian's vault list, ready to reopen; a vault already closed is left
alone.
EOF
}

cmd_remove_help() {
  cat <<'EOF'
Usage: scry remove <dir>...

Forget each vault, as "Remove from list" in the vault picker does: close
its window when open, drop it from the vault list and clear the app data
Obsidian keeps for it. The folder and its notes stay on disk.

The removal is sent from another open vault's window, so the last open
vault cannot be removed.
EOF
}

cmd_prune_help() {
  cat <<'EOF'
Usage: scry prune [-n|--dry-run]

Run `scry remove` on every known vault whose folder no longer exists —
old scratch folders, deleted worktrees. A vault on an unmounted drive
(/Volumes/<name>) or in an iCloud container that is missing (iCloud Drive
off) is skipped with a note on stderr, since it may only be offline.

Options:
  -n, --dry-run  Only print the vaults that would be removed.
EOF
}

cmd_list_help() {
  cat <<'EOF'
Usage: scry list

Print every vault Obsidian knows, one per line, tab-separated:
id, open or closed, path.
EOF
}

cmd_which_help() {
  cat <<'EOF'
Usage: scry which [path]

Print the vault path (default: the current directory) belongs to,
tab-separated: id, vault folder. With vaults nested inside each other the
innermost one wins, as in Obsidian's own lookup. The path need not exist.
EOF
}

cmd_restart_help() {
  cat <<'EOF'
Usage: scry restart

Quit Obsidian, killing it when it doesn't quit in time, then launch it
again in the background and wait for its CLI to answer.

Also the fix when Obsidian runs but its CLI says it is "unable to find
Obsidian": the CLI socket is only bound on a fresh start.
EOF
}

# One CLI call, capped so a wedged one can't hang us. Its own </dev/null
# matters inside `while read` loops: the CLI drains any stdin it gets,
# which would swallow the rest of the loop's input.
cli() {
  perl -e 'alarm shift; exec @ARGV' 10 obsidian-cli "$@" </dev/null 2>&1
}

# An eval's value, without the "=> " prefix. The CLI now and then drops a
# reply and prints nothing, so this retries an empty one: only use it for
# reads and calls that are safe to repeat.
eval_read() {
  local out
  for _ in 1 2 3; do
    out=$(cli "$@" || true)
    if [ -n "$out" ]; then
      printf '%s\n' "${out#=> }"
      return 0
    fi
    sleep 0.3
  done
  return 1
}

# Launches Obsidian when it is not running: in the background (-g), so it
# doesn't steal focus, unless $1 is "front" — only `open` shows a vault.
ensure_ready() {
  # A scalar, not an array: an empty "${a[@]}" trips set -u on the
  # /bin/bash 3.2 that Hammerspoon or launchd may run us with.
  local bg=-g
  [ "${1:-}" = front ] && bg=
  pgrep -xq Obsidian || open ${bg:+"$bg"} -a Obsidian
  local wait_secs=${SCRY_WAIT:-30}
  for _ in $(seq $((wait_secs * 2))); do
    [ "$(cli eval code=1 || true)" = "=> 1" ] && return 0
    sleep 0.5
  done
  echo "scry: Obsidian's CLI did not answer; is it enabled in" \
    "Settings > General > Advanced?" >&2
  exit 1
}

# The vault list as JSON: {"<id>": {"path": ..., "open": true?}, ...}.
# Besides dropping replies, the CLI sometimes answers with an error line
# instead (e.g. "Vault not found." from a window that is closing), so this
# retries any reply that is not a JSON object rather than hand it to jq.
vaults_json() {
  local out
  for _ in 1 2 3; do
    out=$(eval_read eval \
      code="JSON.stringify(window.electron.ipcRenderer.sendSync('vault-list'))" ||
      true)
    if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out"; then
      printf '%s\n' "$out"
      return 0
    fi
    sleep 0.3
  done
  return 1
}

# id of the vault at path $1, empty when unknown.
vault_id() {
  vaults_json | jq -r --arg p "$1" \
    'to_entries[] | select(.value.path == $p) | .key' | head -n 1
}

# id and folder, tab-separated, of the vault holding absolute path $1: the
# longest vault root containing it. Returns 1 when no vault does and 2 (after
# saying why) when the vault list can't be read.
vault_for_path() {
  local json
  if ! json=$(vaults_json); then
    echo "scry: could not read Obsidian's vault list" >&2
    return 2
  fi
  jq -er --arg p "$1" '[to_entries[] |
    (.value.path | rtrimstr("/")) as $v |
    select($p == $v or ($p | startswith($v + "/")))] |
    max_by(.value.path | length) // empty |
    [.key, .value.path] | @tsv' <<<"$json" || return 1
}

# Whether vault $1 is open: 0 open, 1 closed, 2 (after saying so) when
# the vault list can't be read.
vault_open() {
  local json
  if ! json=$(vaults_json); then
    echo "scry: could not read Obsidian's vault list" >&2
    return 2
  fi
  jq -e --arg id "$1" '.[$id].open == true' >/dev/null <<<"$json"
}

# Absolute path, for paths that may be gone: the deepest folder that still
# exists is resolved on disk (so `..` and trailing slashes go), the rest is
# kept as given.
abs_path() {
  local p=$1 rest= base
  case "$p" in
  /*) ;;
  *) p="$PWD/$p" ;;
  esac
  while [ -n "$p" ] && [ ! -d "$p" ]; do
    case ${p##*/} in
    "" | .) ;;
    *) rest="/${p##*/}$rest" ;;
    esac
    p=${p%/*}
  done
  base=$(cd -- "${p:-/}" && pwd)
  rest=${base%/}$rest
  printf '%s\n' "${rest:-/}"
}

cmd_open() {
  case "${1:-}" in
  help | -h | --help)
    cmd_open_help
    return
    ;;
  esac
  if [ $# -gt 1 ]; then
    cmd_open_help >&2
    exit 2
  fi
  local target=${1:-.} dir path_json result
  mkdir -p -- "$target"
  dir=$(cd -- "$target" && pwd)
  ensure_ready front

  path_json=$(jq -Rn --arg p "$dir" '$p')
  result=$(cli eval \
    code="window.electron.ipcRenderer.sendSync('vault-open', $path_json, false)" ||
    true)
  case "$result" in
  "=> true") return 0 ;;
  # When the call opens a new window the CLI often loses the reply, even
  # though the vault opened — check the vault list instead, giving the new
  # window a moment to land in it.
  "")
    for _ in $(seq 10); do
      [ -n "$(vault_id "$dir")" ] && return 0
      sleep 0.5
    done
    ;;
  esac
  result=${result#=> }
  echo "scry: could not open $dir: ${result:-no reply}" >&2
  exit 1
}

# id of the known vault at path $1. Returns 1 (after saying so) when
# Obsidian doesn't know it.
known_vault_id() {
  local id
  id=$(vault_id "$1")
  if [ -z "$id" ]; then
    echo "scry: not a known vault: $1" >&2
    return 1
  fi
  printf '%s\n' "$id"
}

# Close vault $1's window when it is open; $2 is its path, for messages.
# Returns 1 (after saying why) when the window stays open.
# An unreadable vault list fails too: it says nothing about the window.
close_one() {
  local id=$1 dir=$2 rc=0
  vault_open "$id" || rc=$?
  [ "$rc" -eq 1 ] && return 0
  [ "$rc" -eq 2 ] && return 1
  # Closing a window replies with nothing; wait for the list to agree.
  cli vault="$id" eval code="window.close()" >/dev/null || true
  for _ in $(seq 20); do
    rc=0
    vault_open "$id" || rc=$?
    [ "$rc" -eq 1 ] && return 0
    [ "$rc" -eq 2 ] && return 1
    sleep 0.25
  done
  echo "scry: could not close $dir" >&2
  return 1
}

# Forget one vault. Returns 1 (after saying why) when it can't.
remove_one() {
  local dir id path_json result
  dir=$(abs_path "$1")
  id=$(known_vault_id "$dir") || return 1
  close_one "$id" "$dir" || return 1

  # Same cleanup as the picker's "Remove from list": the app data Obsidian
  # keys by vault id goes with the vault.
  path_json=$(jq -Rn --arg p "$dir" '$p')
  # Sent to whichever window is active, now that this one is closed.
  result=$(cli eval code="(() => {
    const ok = window.electron.ipcRenderer.sendSync('vault-remove', $path_json)
    if (ok) {
      const prefix = '$id-'
      indexedDB.databases().then(dbs => dbs
        .filter(db => db.name.startsWith(prefix))
        .forEach(db => indexedDB.deleteDatabase(db.name)))
      Object.keys(localStorage)
        .filter(key => key.startsWith(prefix))
        .forEach(key => localStorage.removeItem(key))
    }
    return ok
  })()" || true)
  [ "$result" = "=> true" ] && return 0
  # A dropped reply may still have removed it.
  [ -z "$result" ] && [ -z "$(vault_id "$dir")" ] && return 0
  result=${result#=> }
  [ "$result" = false ] &&
    result="Obsidian refused; is it the only vault open?"
  echo "scry: could not remove $dir: ${result:-no reply}" >&2
  return 1
}

cmd_close() {
  case "${1:-}" in
  "" | help | -h | --help)
    cmd_close_help
    [ $# -gt 0 ]
    return
    ;;
  esac
  ensure_ready
  local failed=0 arg dir id
  for arg in "$@"; do
    dir=$(abs_path "$arg")
    if id=$(known_vault_id "$dir"); then
      close_one "$id" "$dir" || failed=1
    else
      failed=1
    fi
  done
  return "$failed"
}

cmd_remove() {
  case "${1:-}" in
  "" | help | -h | --help)
    cmd_remove_help
    [ $# -gt 0 ]
    return
    ;;
  esac
  ensure_ready
  local failed=0 dir
  for dir in "$@"; do
    remove_one "$dir" || failed=1
  done
  return "$failed"
}

# Why a missing vault folder $1 may only be offline — on an unmounted
# drive or in an iCloud container that is not there (iCloud Drive off) —
# or nothing when it is really gone.
offline_reason() {
  local icloud="$HOME/Library/Mobile Documents" root
  case "$1" in
  /Volumes/*)
    root=${1#/Volumes/}
    root=/Volumes/${root%%/*}
    [ -d "$root" ] || echo "$root is not mounted"
    ;;
  "$icloud"/*)
    root=${1#"$icloud"/}
    root=$icloud/${root%%/*}
    [ -d "$root" ] || echo "$root is missing (iCloud Drive off?)"
    ;;
  esac
}

cmd_prune() {
  local dry=false
  case "${1:-}" in
  help | -h | --help)
    cmd_prune_help
    return
    ;;
  -n | --dry-run) dry=true ;;
  "") ;;
  *)
    cmd_prune_help >&2
    exit 2
    ;;
  esac
  ensure_ready
  local failed=0 dir paths offline
  # Read the list up front: a failed read inside `< <(...)` would go
  # unnoticed and look like nothing to prune.
  if ! paths=$(vaults_json | jq -r '.[].path'); then
    echo "scry: could not read Obsidian's vault list" >&2
    exit 1
  fi
  while IFS= read -r dir; do
    # An empty list still yields one empty line through <<<.
    [ -n "$dir" ] || continue
    [ -e "$dir" ] && continue
    offline=$(offline_reason "$dir")
    if [ -n "$offline" ]; then
      echo "scry: skipping $dir: $offline" >&2
      continue
    fi
    echo "$dir"
    $dry || remove_one "$dir" || failed=1
  done <<<"$paths"
  return "$failed"
}

cmd_which() {
  case "${1:-}" in
  help | -h | --help)
    cmd_which_help
    return
    ;;
  esac
  if [ $# -gt 1 ]; then
    cmd_which_help >&2
    exit 2
  fi
  local path rc=0
  path=$(abs_path "${1:-.}")
  ensure_ready
  vault_for_path "$path" || rc=$?
  [ "$rc" -eq 1 ] && echo "scry: not inside a known vault: $path" >&2
  return "$rc"
}

cmd_list() {
  case "${1:-}" in
  help | -h | --help)
    cmd_list_help
    return
    ;;
  esac
  ensure_ready
  vaults_json | jq -r 'to_entries[] |
    [.key, (if .value.open then "open" else "closed" end), .value.path] |
    @tsv'
}

cmd_restart() {
  case "${1:-}" in
  help | -h | --help)
    cmd_restart_help
    return
    ;;
  esac
  if pgrep -xq Obsidian; then
    local wait_secs=${SCRY_QUIT_WAIT:-10}
    # Capped: a wedged app never answers the quit event, and osascript
    # would wait out AppleScript's two-minute reply timeout.
    perl -e 'alarm shift; exec @ARGV' "$wait_secs" \
      osascript -e 'quit app "Obsidian"' >/dev/null 2>&1 || true
    for _ in $(seq $((wait_secs * 4))); do
      pgrep -xq Obsidian || break
      sleep 0.25
    done
    if pgrep -xq Obsidian; then
      pkill -9 -x Obsidian || true
      for _ in $(seq 20); do
        pgrep -xq Obsidian || break
        sleep 0.25
      done
    fi
  fi
  ensure_ready
}

# No command at all forwards too, so a bare `obsidian` (aliased to scry)
# still opens the native interactive CLI.
case "${1:-}" in
open)
  shift
  cmd_open "$@"
  ;;
close)
  shift
  cmd_close "$@"
  ;;
remove)
  shift
  cmd_remove "$@"
  ;;
prune)
  shift
  cmd_prune "$@"
  ;;
list)
  shift
  cmd_list "$@"
  ;;
which)
  shift
  cmd_which "$@"
  ;;
restart)
  shift
  cmd_restart "$@"
  ;;
help | -h | --help) cmd_help ;;
*) exec obsidian-cli "$@" ;;
esac
