{
  "permissions": {
    "allow": [
      "Bash(git -C /Users/kelvinstinghen/Developer/dotfiles status)",
      "Bash(git -C /Users/kelvinstinghen/Developer/dotfiles diff)",
      "Bash(git -C /Users/kelvinstinghen/Developer/dotfiles log --oneline -5)",
      "Bash(git -C /Users/kelvinstinghen/Developer/dotfiles add zshrc)",
      "Bash(git -C /Users/kelvinstinghen/Developer/dotfiles commit -m \"$\\(cat <<''EOF''\nrevert\\(zshrc\\): restore simple v alias for nvim\n\nRemove the Kitty tab title function and restore the original simple alias.\n\nCo-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>\nEOF\n\\)\")",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "WebFetch(domain:github.com)",
      "Bash(echo:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/code-review-suggest-fix.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/code-review-autocommit.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    },
    "kix-agents": {
      "source": {
        "source": "github",
        "repo": "0k-software/kix-agents"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/plugins/cache/caveman/caveman/*/src/hooks/caveman-statusline.sh"
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "kitty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
